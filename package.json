{
  "name": "rebornbroadcaster",
  "version": "0.0.9",
  "main": "main.js",
  "description": "A powerful broadcaster app for media professionals.",
  "author": "ConliffeMediaGroup",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "start-headless": "electron . --headless",
    "build": "electron-builder"
  },
  "keywords": [],
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.8.4",
    "electron-updater": "^6.6.2",
    "iconv-lite": "^0.6.3",
    "net": "^1.0.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^35.0.3",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "com.conliffemediagroup.rebornbroadcaster",
    "productName": "RebornBroadcaster",
    "copyright": "Copyright © ConliffeMediaGroup",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**",
      "!node_modules/**/{test,tests,__tests__}/**",
      "!node_modules/**/{docs,doc,example,examples}/**",
      "!node_modules/**/.bin/**",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/*.md"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/win32-x64/ffmpeg.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/KRBroadcasterIcon.png"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "publish": [
    {
      "provider": "github",
      "owner": "CMGCoderTobias",
      "repo": "RebornBroadcaster",
      "private": false
    }
  ]
}
