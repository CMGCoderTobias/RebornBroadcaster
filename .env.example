# RebornBroadcaster (.env example)
# Copy to `.env` (same folder) or set as system environment variables.

# -------------------------
# OPTIONAL (updates)
# -------------------------
# Secure backend update feed (UpdaterServer generic provider)
# Example:
#   http://<server-ip>:49161/updates/rebornbroadcaster
REBORN_UPDATE_FEED_URL=

# Migration builds use the signed RebornUpdateAgent testing registrations when true.
# Testing releases still require a signed testing-access.json on that device.
# The legacy Electron fallback uses the old testing backend route.
IS_TESTING=false

# Legacy fallback (only if backend feed is down and repo is private)
REBORN_GITHUB_TOKEN=
